<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <conversionRule conversionWord="safeMessage" class="pl.syntaxdevteam.syntaxlauncher.desktop.logging.SafeLogMessage"/>
    <property name="LOG_DIR" value="${syntaxlauncher.logs:-${java.io.tmpdir}/syntaxlauncher-logs}"/>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder><pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %safeMessage%n%nopex</pattern></encoder>
    </appender>
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/launcher.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/launcher.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>8MB</maxFileSize>
            <maxHistory>7</maxHistory>
            <totalSizeCap>64MB</totalSizeCap>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
        <encoder><pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level %logger{48} - %safeMessage%n%nopex</pattern></encoder>
    </appender>
    <root level="INFO"><appender-ref ref="CONSOLE"/><appender-ref ref="FILE"/></root>
</configuration>
